    // ---- jenesboat touch controls --------------------------------------------------------
    // One bit per button, in the order of jenesboat_v2/touch.py KEYS (tests check they
    // match).  jb_held: buttons down right now; jb_taps: buttons pressed since the game
    // last called jb_ack().  jb_pad_left / jb_pad_right: CSS px the clusters take at the
    // left and right edges, so the HUD can keep clear of them.  jb_show(...) is called by
    // the game when the prompt, pause state, time compression or legend changes; jb_fit(w, h)
    // when it wants the canvas buffer resized.  jb_difficulty: the ?difficulty=<name> of the
    // page URL (cadet, patrol or veteran), which the game reads once at the start.
    (function () {
        const JB_KEYS = ["W", "S", "A", "D", "Q", "SPACE", "C", "F", "T", "MINUS", "EQUAL",
                         "P", "L", "R", "Y", "N", "TIME"];
        const HOLD = new Set(["A", "D"]);
        const bit = {};
        JB_KEYS.forEach((k, i) => { bit[k] = 1 << i; });
        const pad = document.getElementById("touch");
        const ship = document.getElementById("pad-ship");
        const attack = document.getElementById("pad-attack");

        window.jb_difficulty = new URLSearchParams(window.location.search).get("difficulty") || "";
        window.jb_touch = 0;
        window.jb_held = 0;
        window.jb_taps = 0;
        window.jb_pad_left = 0;
        window.jb_pad_right = 0;
        window.jb_inset_left = 0;
        window.jb_inset_right = 0;
        window.jb_meta_top = function (px) {
            document.getElementById("pad-meta").style.top = px + "px";
            return true;
        };
        window.jb_ack = function () { window.jb_taps = 0; };
        // The game asks for a GL buffer of CSS size x devicePixelRatio, so text is sharp on
        // a phone (the runtime leaves the buffer at the CSS size).
        window.jb_fit = function (w, h) {
            const c = document.getElementById("canvas");
            if (c.width !== w || c.height !== h) { c.width = w; c.height = h; }
            return true;
        };
        window.jb_show = function (confirming, paused, timeScale, legend) {
            pad.classList.toggle("confirm", !!confirming);
            document.getElementById("jb-pause").textContent = paused ? "RUN" : "PAUSE";
            document.getElementById("jb-time").textContent = "x" + timeScale;
            return true;
        };

        const probe = document.createElement("div");
        probe.style.cssText = "position:fixed;visibility:hidden;pointer-events:none;" +
            "padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)";
        document.body.appendChild(probe);
        window.addEventListener("resize", () => { if (window.jb_touch) measure(); });
        window.addEventListener("orientationchange", () => setTimeout(measure, 200));

        function measure() {
            const w = window.innerWidth;
            window.jb_pad_left = window.jb_touch ? ship.getBoundingClientRect().right : 0;
            window.jb_pad_right = window.jb_touch ? w - attack.getBoundingClientRect().left : 0;
            // Rounded corners / notch: the part of the screen the game text must avoid.
            const cs = getComputedStyle(probe);
            window.jb_inset_left = parseFloat(cs.paddingLeft) || 0;
            window.jb_inset_right = parseFloat(cs.paddingRight) || 0;
        }

        function enable() {
            if (window.jb_touch) return;
            window.jb_touch = 1;
            document.body.classList.add("touch");
            measure();
        }

        const coarse = window.matchMedia && window.matchMedia("(pointer: coarse)").matches;
        if (coarse || navigator.maxTouchPoints > 0) enable();
        window.addEventListener("touchstart", enable, { passive: true, once: true });
        window.addEventListener("resize", measure);
        window.addEventListener("orientationchange", () => setTimeout(measure, 100));

        function down(e) {
            const key = e.currentTarget.dataset.key;
            e.preventDefault();
            try { e.currentTarget.setPointerCapture(e.pointerId); } catch (err) {}
            e.currentTarget.classList.add("on");
            window.jb_taps |= bit[key];
            if (HOLD.has(key)) window.jb_held |= bit[key];
        }
        function up(e) {
            const key = e.currentTarget.dataset.key;
            e.currentTarget.classList.remove("on");
            window.jb_held &= ~bit[key];
        }
        pad.querySelectorAll("button[data-key]").forEach((b) => {
            b.addEventListener("pointerdown", down);
            b.addEventListener("pointerup", up);
            b.addEventListener("pointercancel", up);
            b.addEventListener("lostpointercapture", up);
            b.addEventListener("contextmenu", (e) => e.preventDefault());
        });
    })();

    </script>

